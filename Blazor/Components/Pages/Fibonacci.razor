@page "/Fibonacci"
@rendermode InteractiveServer
﻿
@using System.Numerics;

<h3>Число Фибоначчи</h3>

<div>
    <label>Индекс (n):</label>
    <input type="number" @bind="n" @bind:after="Calculate" />
</div>

@if (fibonacciNumbers.Any())
{
    <h4>Последовательность:</h4>
    <p>@string.Join(", ", fibonacciNumbers)</p>
    <p><strong>Всего чисел:</strong> @fibonacciNumbers.Count</p>
    <p><strong>Последнее число:</strong> @fibonacciNumbers.Last()</p>
}
else
{
    <p>Введите n >= 1</p>
}